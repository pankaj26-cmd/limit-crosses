    <string name="perm_open_app_info">ऐप जानकारी खोलें</string>
    <string name="perm_restricted_settings_btn">अनलॉक करने के लिए ऐप जानकारी खोलें</string>
    <string name="perm_restricted_settings_desc">Android 13+ पर ऐप्स के लिए एक बार अनुमति चाहिए। नीचे दिए गए बटन पर टैप करें, ऊपर दाईं ओर 3 डॉट्स (⋮) पर टैप करें और \"Allow restricted settings\" चुनें।</string>
    <string name="perm_restricted_settings_guide">1. ऊपर दाईं ओर ⋮ (3 डॉट्स) पर टैप करें\n2. \"Allow restricted settings\" चुनें\n3. डिवाइस पिन दर्ज करें\n4. वापस आकर उपयोग पहुंच (Usage Access) चालू करें</string>
    <string name="perm_restricted_settings_title">सेटिंग अक्षम (Disabled) दिख रही है?</string>
    <string name="perm_subtitle">लिमिट क्रॉसेस को फ़ोरग्राउंड ऐप्स के उपयोग की सटीक निगरानी के लिए विशिष्ट अनुमतियों की आवश्यकता होती है।</string>
    <string name="perm_title">आवश्यक अनुमतियां</string>
    <string name="perm_usage_btn">उपयोग सेटिंग्स खोलें</string>
    <string name="perm_usage_desc">UsageStatsManager के माध्यम से फेसबुक, इंस्टाग्राम और स्नैपचैट की निगरानी की अनुमति देता है।</string>
    <string name="perm_usage_title">उपयोग एक्सेस (Usage Access)</string>
