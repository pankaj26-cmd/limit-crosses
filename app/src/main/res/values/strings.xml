    <!-- Privacy Screen Details -->
    <string name="privacy_title">Privacy &amp; Data Policy</string>
    <string name="privacy_section_collected_title">What We Collect</string>
    <string name="privacy_section_collected_body">Only total foreground runtime minutes for Facebook, Instagram, and Snapchat. Handled strictly via Android UsageStatsManager.</string>
    <string name="privacy_section_not_collected_title">What We NEVER Collect</string>
    <string name="privacy_section_not_collected_body">We never collect passwords, private messages, camera/audio, keystrokes, personal photos, contacts, GPS location, or unrelated application usage.</string>
    <string name="privacy_section_admin_visibility_title">What Administrators See</string>
    <string name="privacy_section_admin_visibility_body">Admins see: your email/name, daily limit status, total minutes used today, and extension requests. Admins cannot view your personal content or browsing history.</string>
    <string name="privacy_section_retention_title">Data Retention &amp; Deletion</string>
    <string name="privacy_section_retention_body">Aggregated daily usage totals are retained for 30 days for trend analysis and then permanently pruned. Deleting your account deletes all data instantly.</string>

